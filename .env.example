# Zkopírujte do .env a upravte. Makefile i Python čtou tyto proměnné z prostředí;
# .env se načítá automaticky (pvk.config), pokud existuje.

# Databáze platformy (docker compose ji vystaví na portu 55432)
DATABASE_URL=postgresql://pvk:pvk@localhost:55432/pvk

# Kam se ukládají stažené soubory (obsahově adresované podle SHA-256). Není v gitu.
PVK_DATA_DIR=data

# Identifikace klienta vůči zdrojům (bez osobních údajů)
PVK_USER_AGENT=DatovePole-PVK/0.1 (pilot mereni kvality dat; nizka frekvence dotazu)

# Pilot: seed náhodných výběrů a sledované období (poslední celé 12 měsíce před pilotem)
PVK_PILOT_SEED=20260925
PVK_PILOT_OBDOBI_OD=2025-09-01
PVK_PILOT_OBDOBI_DO=2026-09-01

# Registr smluv: auto = oficiální otevřená data, při nedostupnosti zrcadlo Hlídač státu
# (oficialni | hlidac | auto)
PVK_RS_BACKEND=oficialni
# pilot: auto = oficiální, při nedostupnosti zrcadlo Hlídač státu (jen pilot, D-030)
PVK_PILOT_RS_BACKEND=auto

# Kotva: v pilotu ARES. Později "db" + KOTVA_DATABASE_URL (dotaz do databáze kotvy).
PVK_KOTVA=ares
# KOTVA_DATABASE_URL=postgresql://...

# Sběr do raw (make sber): období [PVK_SBER_OD, PVK_SBER_DO), výchozí poslední měsíc do dneška.
# PVK_SBER_OD=2026-08-26
# PVK_SBER_DO=2026-09-26
# NEN: jen vybrané profily zadavatelů (kódy čárkami); výchozí = všechny platné profily v NEN
# PVK_SBER_NEN_PROFILY=MVCR,DIA
